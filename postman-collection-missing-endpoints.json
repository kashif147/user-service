{
  "info": {
    "name": "User Service — Missing Endpoints",
    "description": "Endpoints not covered by the main User Service Postman collection. Same {{baseUrl}} / {{authToken}} / {{tenantId}} variables as the primary collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "authToken", "value": "", "type": "string" },
    { "key": "tenantId", "value": "", "type": "string" },
    { "key": "productTypeId", "value": "", "type": "string" },
    { "key": "productId", "value": "", "type": "string" },
    { "key": "pricingId", "value": "", "type": "string" },
    { "key": "contactId", "value": "", "type": "string" },
    { "key": "contactTypeId", "value": "", "type": "string" },
    { "key": "roleId", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "roleCode", "value": "SU", "type": "string" },
    { "key": "tenantDbId", "value": "", "type": "string", "description": "Mongo _id for tenant routes" },
    { "key": "connectionId", "value": "", "type": "string" },
    { "key": "permissionCategory", "value": "general", "type": "string" },
    { "key": "policyCacheKey", "value": "", "type": "string" },
    { "key": "tenantDomain", "value": "example.com", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health & sessions",
      "item": [
        {
          "name": "GET Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "POST Sessions (B2C id_token)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"<paste_b2c_id_token>\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["sessions"]
            }
          }
        }
      ]
    },
    {
      "name": "Me",
      "item": [
        {
          "name": "GET Current user profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "x-tenant-id", "value": "{{tenantId}}", "disabled": true }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Users (B2C validate)",
      "item": [
        {
          "name": "POST Validate user (Azure B2C policy)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Authorization",
                "value": "Basic <base64(user:pass)>",
                "description": "Optional if B2C_API_USERNAME/PASSWORD set",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/validate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "validate"]
            }
          }
        }
      ]
    },
